            "type": "postgres",
            "uid": "PASCUAL_POSTGRES_DS"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) AS fallas_detectadas\nFROM silver.lectura_5min\nWHERE\n  $__timeFilter(ts)\n  AND EXTRACT(HOUR FROM ts) >= 9\n  AND EXTRACT(HOUR FROM ts) < 15\n  AND p_ac_kw = 0\n  AND dispositivo_id = 1;",
          "refId": "A"
        }
      ]
