          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  ROUND(SUM(p_ac_kw * (5.0 / 60.0)), 2) AS \"Energía (kWh)\"\nFROM silver.lectura_5min\nWHERE\n  $__timeFilter(ts)\n  AND dispositivo_id = 1;",
